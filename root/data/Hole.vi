
use util::transmute;

/// A value of type `T` that may not exist yet; it is supplied through the
/// space returned alongside it by `Hole::new`.
/// ```vi
/// let (hole, space) = Hole::new[N32]();
/// ~space = 46;
/// hole.get() // 46
/// ```
pub type Hole[T];

pub mod Hole {
  /// Creates a new hole, returning it and the space through which its value is
  /// supplied.
  #[intrinsic = "hole:new"]
  pub fn new[T]() -> (Hole[T], ~T) {
    let loop value;
    (safe transmute(value), ~value)
  }

  /// Creates a hole whose value has already been supplied.
  #[intrinsic = "hole:of"]
  pub fn of[T](value: T) -> Hole[T] {
    safe transmute(value)
  }

  /// Returns the hole's value, waiting for it to be supplied if necessary.
  #[intrinsic = "hole:get"]
  pub fn .get[T](self: Hole[T]) -> T {
    safe transmute(self)
  }

  /// Passes the hole's value on to `to`, once it is supplied.
  #[intrinsic = "hole:forward"]
  pub fn .forward[T](self: Hole[T], to: ~T) {
    ~to = self.get();
  }

  /// Borrows the hole's value, waiting for it to be supplied if necessary.
  #[intrinsic = "hole:as_ref"]
  pub fn .as_ref[T](&self: &Hole[T]) -> &T {
    safe transmute[&Hole[T], &T](&self)
  }

  pub impl drop[T?]: Drop[Hole[T]] {
    fn drop(self: Hole[T]) {
      _ = self.get();
    }
  }
}
