
use data::Hole;
use util::transmute;

/// The read end of a single-use slot for a value of type `T`; the value is
/// supplied through the corresponding `Hole`, possibly only later.
/// ```vi
/// let (promise, hole) = Hole::new[N32]();
/// hole.set(46);
/// promise.get() // 46
/// ```
pub type Promise[T];

pub mod Promise {
  /// Creates a promise that is already fulfilled with `value`.
  #[intrinsic = "promise:of"]
  pub fn of[T](value: T) -> Promise[T] {
    safe transmute(value)
  }

  /// Returns the promised value, waiting for it to be supplied if necessary.
  #[intrinsic = "promise:get"]
  pub fn .get[T](self: Promise[T]) -> T {
    safe transmute(self)
  }

  /// Passes the promised value on to `to`, once it is supplied.
  #[intrinsic = "promise:forward"]
  pub fn .forward[T](self: Promise[T], to: ~T) {
    ~to = self.get();
  }

  /// Fills `hole` with the promised value, once it is supplied.
  #[intrinsic = "promise:link"]
  pub fn .link[T](self: Promise[T], hole: Hole[T]) {
    hole.set(self.get());
  }

  /// Borrows the promised value, waiting for it to be supplied if necessary.
  #[intrinsic = "promise:as_ref"]
  pub fn .as_ref[T](&self: &Promise[T]) -> &T {
    safe transmute[&Promise[T], &T](&self)
  }

  pub impl drop[T?]: Drop[Promise[T]] {
    fn drop(self: Promise[T]) {
      _ = self.get();
    }
  }
}
