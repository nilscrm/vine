
pub mod arithmetic;
pub mod bitwise;
pub mod comparison;
pub mod elementwise;
pub mod flex;
pub mod Index;
pub mod Range;

use util::unreachable;

pub trait[A, B] Concat[O] {
  #[builtin = "concat"]
  fn concat(a: A, b: B) -> O;
}

pub trait[C, T] Cast {
  #[builtin = "cast"]
  fn cast(value: C) -> T;
}

pub mod Cast {
  pub impl identity[T]: Cast[T, T] {
    fn cast(value: T) -> T {
      value
    }
  }

  pub impl ref[C, T; Cast[C, T], Cast[T, C]]: Cast[&C, &T] {
    fn cast(&c: &C) -> &T {
      let t = c as T;
      let ref = &t;
      c = t as C;
      ref
    }
  }

  pub impl never[T]: Cast[!, T] {
    fn cast(_: !) -> T {
      safe unreachable()
    }
  }
}

/// Describes how values of type `T` are stored; implemented automatically for
/// every type. Each type parameter implicitly requires an implementation, so
/// that generic code can be specialized for the layouts of its type
/// parameters.
#[builtin = "Layout"]
pub unsafe trait[T] Layout {}

#[builtin = "Fn"]
pub trait[F] Fn[P, R] {
  fn .call(f: F, params: P) -> R;
}
