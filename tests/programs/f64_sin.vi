  for (x, w) in pairs {
    let a = F64::from_bits(x).sin_bounded().to_bits();
    let d = if a >= w { a - w } else { w - a };
    assert d <= 4[N64] else { debug::error("sine ULP regression") }
  }
  assert
    F64::from_bits(0x8000000000000000[N64]).sin_bounded().to_bits() == 0x8000000000000000[N64]
  else {
    debug::error("negative zero")
  }
  assert 0.0[F64].sin_bounded().to_bits() == 0[N64] else { debug::error("positive zero") }
  let p = F64::inf.sin_bounded();
  let n = F64::neg_inf.sin_bounded();
  let a = F64::nan.sin_bounded();
  assert (p != p) & (n != n) & (a != a) else { debug::error("nonfinite") }
  io.println("passed");
}
