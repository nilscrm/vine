
use #root::ops::{Cast, Concat, arithmetic::{Mul, Pow}};

enum* List[T] {
  Nil(),
  Cons(T, Box[List[T]]),
}

use List::{Cons, Nil};

mod List {
  pub impl [T]: Concat[List[T], List[T], List[T]] {
    fn concat(x: List[T], y: List[T]) -> List[T] {
      match x {
        Cons(t, Box(x)) { Cons(t, Box(x ++ y)) }
        Nil() { y }
      }
    }
  }

  pub impl [A*, B]: Mul[A, List[B], List[(A, B)]] {
    fn mul(a: A, y: List[B]) -> List[(A, B)] {
      match y {
        Cons(b, Box(y)) { Cons((a, b), Box(a * y)) }
        Nil() { Nil() }
      }
    }
  }

  pub impl [A*, B*]: Pow[List[A], List[B], List[(A, B)]] {
    fn pow(x: List[A], y: List[B]) -> List[(A, B)] {
      match x {
        Cons(a, Box(x)) { a * y ++ x ** y }
        Nil() { Nil() }
      }
    }
  }

  pub impl [T?; Show[T]]: Cast[List[T], String] {
    fn cast(x: List[T]) -> String {
      match x {
        Cons(t, Box(x)) { "{t.show()};{x}" }
        Nil() { "" }
      }
    }
  }
}

pub fn main(&io: &IO) {
  let x = Cons(1, Box(Cons(2, Box(Cons(3, Box(Nil()))))));
  let y = Cons(4, Box(Cons(5, Box(Cons(6, Box(Nil()))))));
  io.println("{x} ++ {y} = {x ++ y}");
  io.println("{x} ** {y} = {x ** y}");
}
